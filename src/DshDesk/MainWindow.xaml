<Window x:Class="DshDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DSH Desk"
        Width="1280"
        Height="820"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/app-icon.ico"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="42" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Root" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceBackground}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="StatusButtonStyle" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="StatusRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StatusRoot" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StatusRoot" Property="Background" Value="{DynamicResource SurfaceBackground}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Padding" Value="16,9" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ActionRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ActionRoot" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ActionRoot" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ActionRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ErrorCardActionButtonBase" TargetType="Button">
      <Setter Property="Height" Value="42" />
      <Setter Property="MinWidth" Value="164" />
      <Setter Property="Padding" Value="18,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ErrorActionRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ErrorActionRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter TargetName="ErrorActionRoot" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ErrorActionRoot" Property="Opacity" Value="0.78" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ErrorActionRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter TargetName="ErrorActionRoot" Property="BorderThickness" Value="2" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ErrorPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource ErrorCardActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="ErrorSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource ErrorCardActionButtonBase}">
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style x:Key="ErrorUtilityButton" TargetType="Button">
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="Margin" Value="2,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ErrorUtilityRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ErrorUtilityRoot" Property="Background" Value="{DynamicResource SurfaceBackground}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ErrorUtilityRoot" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ErrorUtilityRoot" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="MenuItemRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="MenuItemRoot" Property="Background" Value="{DynamicResource SurfaceBackground}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="MenuItemRoot" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DrawerSecondaryButton" TargetType="Button">
      <Setter Property="Height" Value="38" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DrawerSecondaryRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DrawerSecondaryRoot" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DrawerSecondaryRoot" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DrawerPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource DrawerSecondaryButton}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DrawerTextActionButton" TargetType="Button">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="DrawerTextActionRoot"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="DrawerTextActionRoot" Property="Background" Value="{DynamicResource SurfaceBackground}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="DrawerTextActionRoot" Property="Opacity" Value="0.72" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="34" Height="20">
              <Border x:Name="SwitchTrack"
                      Background="{DynamicResource SurfaceBackground}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="10" />
              <Ellipse x:Name="SwitchThumb"
                       Width="14"
                       Height="14"
                       Margin="3"
                       HorizontalAlignment="Left"
                       Fill="{DynamicResource TextSecondary}" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="SwitchThumb" Property="Fill" Value="White" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemedScrollBarLineButton" TargetType="RepeatButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border x:Name="LineButtonRoot"
                    Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="LineButtonRoot"
                        Property="Background"
                        Value="{DynamicResource AppBorderBrush}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="LineButtonRoot"
                        Property="Background"
                        Value="{DynamicResource AccentPressedBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ThemedVerticalScrollBar" TargetType="ScrollBar">
      <Setter Property="Width" Value="14" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBackground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Width="{TemplateBinding Width}"
                  Background="{TemplateBinding Background}">
              <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
              </Grid.RowDefinitions>

              <RepeatButton Grid.Row="0"
                            Style="{StaticResource ThemedScrollBarLineButton}"
                            Command="{x:Static ScrollBar.LineUpCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Width="7"
                      Height="4"
                      Data="M 0 4 L 3.5 0 L 7 4"
                      Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.25" />
              </RepeatButton>

              <Track x:Name="PART_Track"
                     Grid.Row="1"
                     IsDirectionReversed="True"
                     Maximum="{TemplateBinding Maximum}"
                     Minimum="{TemplateBinding Minimum}"
                     Value="{TemplateBinding Value}"
                     ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Static ScrollBar.PageUpCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                FocusVisualStyle="{x:Null}"
                                IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb MinHeight="28"
                         Background="{DynamicResource TextSecondary}"
                         FocusVisualStyle="{x:Null}">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbRoot"
                                Margin="3,1"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbRoot"
                                    Property="Background"
                                    Value="{DynamicResource AccentHoverBrush}" />
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbRoot"
                                    Property="Background"
                                    Value="{DynamicResource AccentPressedBrush}" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Background="Transparent"
                                BorderThickness="0"
                                Command="{x:Static ScrollBar.PageDownCommand}"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                FocusVisualStyle="{x:Null}"
                                IsTabStop="False" />
                </Track.IncreaseRepeatButton>
              </Track>

              <RepeatButton Grid.Row="2"
                            Style="{StaticResource ThemedScrollBarLineButton}"
                            Command="{x:Static ScrollBar.LineDownCommand}"
                            CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                <Path Width="7"
                      Height="4"
                      Data="M 0 0 L 3.5 4 L 7 0"
                      Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.25" />
              </RepeatButton>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
    <Grid>
      <DockPanel LastChildFill="True">

      <Grid x:Name="TitleBar"
            DockPanel.Dock="Top"
            Height="42"
            Background="{DynamicResource ChromeBackground}"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown"
            MouseMove="TitleBar_OnMouseMove"
            MouseLeftButtonUp="TitleBar_OnMouseLeftButtonUp">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
          <Image Width="25" Height="25" Source="Assets/app-icon.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="DSH Desk" Margin="9,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button x:Name="StatusButton"
                  Style="{StaticResource StatusButtonStyle}"
                  Click="StatusButton_OnClick">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
              <TextBlock x:Name="StatusText" Text="正在启动" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsButton"
                  Style="{StaticResource TitleButton}"
                  ToolTip="DSH Desk 设置"
                  Click="SettingsButton_OnClick">
            <Grid>
              <TextBlock Text="⚙" FontSize="16" />
              <Ellipse x:Name="UpdateBadge"
                       Width="7"
                       Height="7"
                       Margin="18,-3,0,0"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Fill="#E09B3D"
                       Visibility="Collapsed" />
            </Grid>
          </Button>
          <Button Style="{StaticResource TitleButton}" ToolTip="最小化" Click="MinimizeButton_OnClick">
            <TextBlock Text="─" />
          </Button>
          <Button x:Name="MaximizeButton"
                  FontFamily="Segoe MDL2 Assets"
                  FontSize="10"
                  Click="MaximizeButton_OnClick">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TitleButton}">
                <Setter Property="Content" Value="&#xE922;" />
                <Setter Property="ToolTip" Value="最大化" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                    <Setter Property="Content" Value="&#xE923;" />
                    <Setter Property="ToolTip" Value="还原" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <Button x:Name="CloseButton" Style="{StaticResource TitleButton}" ToolTip="关闭到托盘" Click="CloseButton_OnClick">
            <TextBlock Text="✕" />
          </Button>
        </StackPanel>
      </Grid>

      <Border DockPanel.Dock="Bottom"
              Height="6"
              Background="{DynamicResource ChromeBackground}"
              Cursor="SizeNS"
              shell:WindowChrome.ResizeGripDirection="Bottom">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <Border DockPanel.Dock="Right"
              Width="6"
              Background="{DynamicResource ChromeBackground}"
              Cursor="SizeWE"
              shell:WindowChrome.ResizeGripDirection="Right">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <Border DockPanel.Dock="Left"
              Width="6"
              Background="{DynamicResource ChromeBackground}"
              Cursor="SizeWE"
              shell:WindowChrome.ResizeGripDirection="Left">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                <Setter Property="Visibility" Value="Collapsed" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
      </Border>

      <Grid Background="{DynamicResource WindowBackground}">
        <wv2:WebView2 x:Name="HarnessWebView" Visibility="Hidden" />

        <Grid x:Name="LaunchOverlay" Background="{DynamicResource WindowBackground}">
          <Border Width="520"
                  MaxWidth="520"
                  Padding="34"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Background="{DynamicResource PanelBackground}"
                  BorderBrush="{DynamicResource AppBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="14">
            <StackPanel>
              <Image Width="64" Height="64" Source="Assets/app-icon.png" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />
              <TextBlock x:Name="StartupTitle"
                         Text="正在启动 DeepSeek Harness"
                         Margin="0,20,0,7"
                         FontSize="20"
                         FontWeight="SemiBold"
                         TextAlignment="Center" />
              <TextBlock x:Name="StartupDetail"
                         Text="正在检查本机环境…"
                         Foreground="{DynamicResource TextSecondary}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <ProgressBar x:Name="StartupProgress"
                           Height="4"
                           Margin="0,24,0,0"
                           IsIndeterminate="True"
                           Foreground="{DynamicResource AccentBrush}" />
              <StackPanel x:Name="ErrorActions" Visibility="Collapsed" Margin="0,24,0,0">
                <Grid x:Name="MissingInstallationActions"
                      Width="360"
                      HorizontalAlignment="Center"
                      Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Button x:Name="CopyInstallCommandButton"
                          Grid.Column="0"
                          Style="{StaticResource ErrorPrimaryButton}"
                          Content="复制安装命令"
                          Click="CopyInstallCommandButton_OnClick" />
                  <Button x:Name="ChooseInstallationButton"
                          Grid.Column="2"
                          Style="{StaticResource ErrorSecondaryButton}"
                          Content="选择已有 DSH"
                          Click="ChooseInstallationButton_OnClick" />
                </Grid>
                <Button x:Name="RetryButton"
                        Style="{StaticResource ErrorPrimaryButton}"
                        HorizontalAlignment="Center"
                        Content="重试"
                        Click="RetryButton_OnClick" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">
                  <Button x:Name="DetectAgainButton"
                          Style="{StaticResource ErrorUtilityButton}"
                          Content="重新检测"
                          Visibility="Collapsed"
                          Click="RetryButton_OnClick" />
                  <Button Style="{StaticResource ErrorUtilityButton}"
                          Content="查看日志"
                          Click="OpenLogsButton_OnClick" />
                  <Button Style="{StaticResource ErrorUtilityButton}"
                          Content="退出"
                          Click="ExitButton_OnClick" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
      </DockPanel>

      <Popup x:Name="StatusPopup"
             Grid.Row="0"
             PlacementTarget="{Binding ElementName=StatusButton}"
             Placement="Bottom"
             HorizontalOffset="0"
             VerticalOffset="6"
             StaysOpen="False"
             PopupAnimation="Fade"
             AllowsTransparency="True"
             Opened="StatusPopup_OnOpened"
             Closed="StatusPopup_OnClosed">
        <Border x:Name="StatusPopupCard"
                Width="360"
                Padding="18"
                Background="{DynamicResource PanelBackground}"
                TextElement.Foreground="{DynamicResource TextPrimary}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.18" Color="#000000" />
          </Border.Effect>
          <StackPanel>
            <TextBlock Text="本机服务状态" FontSize="16" FontWeight="SemiBold" Margin="4,0,0,12" />
            <TextBlock x:Name="PopupStatusText"
                       Text="正在检查"
                       Margin="4,0"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="PopupAddressText"
                       Margin="4,7,0,0"
                       Foreground="{DynamicResource TextSecondary}" />
            <TextBlock x:Name="PopupVersionText"
                       Margin="4,4,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap" />
            <Separator Margin="0,18,0,8" Background="{DynamicResource AppBorderBrush}" />
            <Button Style="{StaticResource MenuButton}" Content="重新连接 / 重启 DSH" Click="RestartButton_OnClick" />
            <Button x:Name="CopyAddressButton"
                    Style="{StaticResource MenuButton}"
                    Content="复制本地地址"
                    IsEnabled="False"
                    Click="CopyAddressButton_OnClick" />
            <Button x:Name="OpenInBrowserButton"
                    Style="{StaticResource MenuButton}"
                    Content="在浏览器中打开"
                    IsEnabled="False"
                    Click="OpenInBrowserButton_OnClick" />
            <Button Style="{StaticResource MenuButton}" Content="查看启动日志" Click="OpenLogsButton_OnClick" />
          </StackPanel>
        </Border>
      </Popup>

      <Popup x:Name="SettingsPopup"
             Grid.Row="0"
             PlacementTarget="{Binding ElementName=CloseButton}"
             Placement="Bottom"
             HorizontalOffset="-414"
             VerticalOffset="0"
             StaysOpen="False"
             PopupAnimation="Slide"
             AllowsTransparency="True"
             Opened="SettingsPopup_OnOpened"
             Closed="SettingsPopup_OnClosed">
        <Border x:Name="SettingsDrawer"
                Width="460"
                Background="{DynamicResource PanelBackground}"
                TextElement.Foreground="{DynamicResource TextPrimary}"
                BorderBrush="{DynamicResource AppBorderBrush}"
                BorderThickness="1,0,0,0">
          <Border.Effect>
            <DropShadowEffect BlurRadius="20" Direction="180" ShadowDepth="5" Opacity="0.14" Color="#000000" />
          </Border.Effect>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="68" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Panel.ZIndex="2"
                    Width="36"
                    Height="36"
                    Margin="0,10,12,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Style="{StaticResource TitleButton}"
                    ToolTip="关闭设置"
                    Click="CloseSettingsButton_OnClick">
              <TextBlock Text="✕" FontSize="13" />
            </Button>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar"
                     BasedOn="{StaticResource ThemedVerticalScrollBar}" />
            </ScrollViewer.Resources>
            <StackPanel Margin="24,22,18,28">
              <TextBlock Text="DSH 运行环境"
                         Margin="0,0,44,12"
                         FontSize="15"
                         FontWeight="SemiBold" />
              <Border Margin="0,0,0,20"
                      Padding="14"
                      Background="{DynamicResource SurfaceBackground}"
                      BorderThickness="0"
                      CornerRadius="5">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="EnvironmentStatusDot"
                           Width="9"
                           Height="9"
                           Margin="0,5,10,0"
                           VerticalAlignment="Top"
                           Fill="{DynamicResource AccentBrush}" />
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="EnvironmentConnectionText"
                               Text="正在检查"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="EnvironmentVersionText"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="EnvironmentSourceText"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock x:Name="EnvironmentPathText"
                               Margin="0,3,0,0"
                               Foreground="{DynamicResource TextSecondary}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button x:Name="ChangeRuntimeEnvironmentButton"
                            Margin="-12,7,0,-7"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DrawerTextActionButton}"
                            Foreground="{DynamicResource AccentHoverBrush}"
                            Content="更改运行环境"
                            Click="ChangeRuntimeEnvironmentButton_OnClick" />
                  </StackPanel>
                </Grid>
              </Border>

              <StackPanel x:Name="EnvironmentConfigurationPanel"
                          Margin="0,-4,0,22"
                          Visibility="Collapsed">
                <RadioButton x:Name="AutoDetectRadioButton"
                             Content="使用检测到的 DSH"
                             Foreground="{DynamicResource TextPrimary}"
                             Margin="2,0,2,8"
                             Checked="InstallationModeRadioButton_OnChanged" />
                <Border Margin="0,0,0,14"
                        Padding="12"
                        Background="{DynamicResource SurfaceBackground}"
                        BorderThickness="0"
                        CornerRadius="5">
                  <TextBlock x:Name="DetectedInstallationText"
                             Text="打开设置后自动检测"
                             Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap" />
                </Border>

                <RadioButton x:Name="SpecifiedPathRadioButton"
                             Content="选择本地 DSH"
                             Foreground="{DynamicResource TextPrimary}"
                             Margin="2,0,2,8"
                             Checked="InstallationModeRadioButton_OnChanged" />
                <StackPanel x:Name="SpecifiedInstallationPanel">
                  <Border Padding="11"
                          Background="{DynamicResource SurfaceBackground}"
                          BorderThickness="0"
                          CornerRadius="5">
                    <TextBlock x:Name="SpecifiedInstallationPathText"
                               Text="尚未选择 @deepseek-ai/dsh 包目录"
                               Foreground="{DynamicResource TextSecondary}"
                               TextWrapping="Wrap" />
                  </Border>
                  <Button Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          Style="{StaticResource DrawerSecondaryButton}"
                          Content="浏览…"
                          Click="SelectDshPackageButton_OnClick" />
                </StackPanel>
              </StackPanel>

              <TextBlock Text="工作区目录" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Padding="11,0"
                        Height="38"
                        VerticalAlignment="Center"
                        Background="{DynamicResource PanelBackground}"
                        BorderBrush="{DynamicResource AppBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7">
                  <TextBlock x:Name="WorkspacePathText"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondary}"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <Button Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource DrawerSecondaryButton}"
                        Content="浏览…"
                        Click="SelectWorkspaceButton_OnClick" />
              </Grid>
              <TextBlock Text="DSH 将在该目录中读取和修改文件"
                         Margin="0,7,0,24"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondary}" />

              <TextBlock Text="启动与窗口" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
              <Grid MinHeight="46">
                <TextBlock Text="关闭窗口时最小化到系统托盘"
                           Margin="0,0,52,0"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="{DynamicResource TextPrimary}" />
                <CheckBox x:Name="CloseToTrayCheckBox"
                          Style="{StaticResource SwitchCheckBox}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Checked="CloseToTrayCheckBox_OnChanged"
                          Unchecked="CloseToTrayCheckBox_OnChanged" />
              </Grid>
              <Grid MinHeight="58">
                <StackPanel Margin="0,8,52,8" VerticalAlignment="Center">
                  <TextBlock Text="开机自动启动"
                             FontSize="14"
                             Foreground="{DynamicResource TextPrimary}" />
                  <TextBlock Text="启动后静默进入系统托盘"
                             Margin="0,3,0,0"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondary}" />
                </StackPanel>
                <CheckBox x:Name="LaunchAtLoginCheckBox"
                          Style="{StaticResource SwitchCheckBox}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Checked="LaunchAtLoginCheckBox_OnChanged"
                          Unchecked="LaunchAtLoginCheckBox_OnChanged" />
              </Grid>

              <TextBlock Text="更新与版本" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,10" />
              <Border Padding="12"
                      Background="{DynamicResource SurfaceBackground}"
                      BorderBrush="{DynamicResource AppBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8">
                <StackPanel>
                  <TextBlock x:Name="DeskUpdateText"
                             Text="DSH Desk：尚未检查"
                             Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap" />
                  <TextBlock x:Name="DshUpdateText"
                             Text="系统 DSH：尚未检查"
                             Margin="0,6,0,0"
                             Foreground="{DynamicResource TextSecondary}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <Button x:Name="CheckUpdatesButton"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource DrawerSecondaryButton}"
                      Content="检查更新"
                      Click="CheckUpdatesButton_OnClick" />
              <Button x:Name="OpenDeskReleaseButton"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource DrawerSecondaryButton}"
                      Content="打开 DSH Desk Release"
                      Visibility="Collapsed"
                      Click="OpenDeskReleaseButton_OnClick" />
              <Button x:Name="CopyDshUpdateCommandButton"
                      Margin="0,8,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource DrawerSecondaryButton}"
                      Content="复制 DSH 更新命令"
                      Visibility="Collapsed"
                      Click="CopyDshUpdateCommandButton_OnClick" />

              <TextBlock Text="数据与高级操作" FontSize="15" FontWeight="SemiBold" Margin="0,24,0,10" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource DrawerSecondaryButton}"
                        Content="打开数据目录"
                        Click="OpenDataButton_OnClick" />
                <Button Grid.Column="2"
                        Style="{StaticResource DrawerSecondaryButton}"
                        Content="打开日志目录"
                        Click="OpenLogsButton_OnClick" />
              </Grid>
              <Button Margin="0,10,0,0"
                      HorizontalAlignment="Stretch"
                      Style="{StaticResource DrawerTextActionButton}"
                      Foreground="{DynamicResource DangerBrush}"
                      Content="退出 DSH Desk"
                      Click="ExitButton_OnClick" />
            </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="1"
                    Padding="16,14"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0,1,0,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="1.4*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Style="{StaticResource DrawerSecondaryButton}"
                        Content="取消"
                        Click="CloseSettingsButton_OnClick" />
                <Button Grid.Column="2"
                        Style="{StaticResource DrawerPrimaryButton}"
                        Content="保存并重新连接"
                        Click="SaveAndReconnectButton_OnClick" />
              </Grid>
            </Border>
          </Grid>
        </Border>
      </Popup>

    </Grid>
  </Border>
</Window>
