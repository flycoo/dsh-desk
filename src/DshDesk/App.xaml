<Application x:Class="DshDesk.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#0F1312" />
    <SolidColorBrush x:Key="ChromeBackground" Color="#171C1A" />
    <SolidColorBrush x:Key="PanelBackground" Color="#1D2421" />
    <SolidColorBrush x:Key="SurfaceBackground" Color="#242C28" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#343E39" />
    <SolidColorBrush x:Key="TextPrimary" Color="#EEF4F1" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9BACA3" />
    <SolidColorBrush x:Key="AccentBrush" Color="#087F56" />
    <SolidColorBrush x:Key="AccentSurfaceBrush" Color="#19362D" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0A9565" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#066744" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
  </Application.Resources>
</Application>
